rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow all authenticated users to read and write files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Also allow uploads folder specifically
    match /uploads/{patientId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
